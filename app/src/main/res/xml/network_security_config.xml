<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is allowed so custom AI providers on a local network (e.g. http://192.168.1.10:8080/api)
    can be reached. All built-in endpoints are https. User-installed CAs are intentionally NOT trusted
    here; custom providers opt into them per connection (see CustomProviderTls).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
