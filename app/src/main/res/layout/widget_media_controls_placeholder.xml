<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker preview and initial layout; mirrors MediaControlsWidget's default look, but
     sized smaller than the live widget because pickers draw previews in a narrow, scaled-down slot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_media_controls_placeholder_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/widget_media_controls_art_placeholder">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:alpha="0.7"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_media_controls_music_note" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_media_controls_nothing_playing"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/media_seek_back"
                    android:src="@drawable/ic_media_controls_rewind" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_outline_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_previous"
                        android:src="@drawable/ic_media_controls_previous" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_play_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_play_pause"
                        android:src="@drawable/ic_media_controls_play"
                        android:tint="@android:color/black" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_outline_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_next"
                        android:src="@drawable/ic_media_controls_next" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/media_seek_forward"
                    android:src="@drawable/ic_media_controls_fast_forward" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

</FrameLayout>
