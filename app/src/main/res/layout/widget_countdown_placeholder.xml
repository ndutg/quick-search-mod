<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker preview and initial layout; mirrors CountdownWidget's default look (a 60% opaque
     card that follows the system theme) with an hourglass standing in for the countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_note_placeholder_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_countdown"
        android:tint="@color/widget_note_placeholder_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_countdown_widget_title"
        android:textColor="@color/widget_note_placeholder_content"
        android:textSize="14sp" />

</LinearLayout>
