<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the app -->
    <style name="Theme.QuickSearch" parent="Theme.AppCompat.NoActionBar">
        <!-- Keep window translucent throughout -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <!-- Disable animations and configure window -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Home entry point. Android renders the system wallpaper behind transparent
         regions of this window; Compose paints an opaque background for every
         source except the active launcher's System wallpaper source. -->
    <style name="Theme.QuickSearch.Opaque" parent="Theme.QuickSearch">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

</resources>
